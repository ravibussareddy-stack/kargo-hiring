# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend (leave RESEND_API_KEY blank to disable sending)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Arjun Mehta <onboarding@resend.dev>
# comma-separated; sends to any other domain are blocked
ALLOWED_RECIPIENT_DOMAINS=

# Dashboard login (HTTP Basic Auth). Required in production.
DASHBOARD_USER=arjun
DASHBOARD_PASSWORD=
