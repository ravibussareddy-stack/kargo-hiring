# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
# optional: comma-separated backup keys, tried in order on quota/rate-limit errors
GEMINI_API_KEYS_BACKUP=
GEMINI_MODEL=gemini-3.8-flash

# Resend (leave RESEND_API_KEY blank to disable sending)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Arjun Mehta <onboarding@resend.dev>
# Test allowlist — sends to anything else are blocked.
# Exact addresses (+tags ignored), comma-separated:
ALLOWED_RECIPIENTS=
# Whole domains, comma-separated (only for a dedicated test domain, never gmail.com):
ALLOWED_RECIPIENT_DOMAINS=

# Dashboard login (HTTP Basic Auth). Required in production.
DASHBOARD_USER=arjun
DASHBOARD_PASSWORD=

# LOCAL ONLY (for `npm run db:migrate`). Do not add to Vercel.
# Supabase -> Connect -> Session pooler connection string
SUPABASE_DB_URL=

# Test mode: every send goes to the first ALLOWED_RECIPIENTS address,
# with the intended recipient shown at the top of the email.
TEST_MODE=true
# Minimum gap between Gemini calls (ms)
GEMINI_MIN_INTERVAL_MS=1000
